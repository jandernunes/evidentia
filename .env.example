# Copie para .env. Preencha antes de usar o banco, login ou IA.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
OPENAI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=35000
STORAGE_PATH=./storage
# Usadas somente pelo comando account:create. Nunca ficam no frontend.
ACCOUNT_NAME=
ACCOUNT_EMAIL=
ACCOUNT_PASSWORD=
ACCOUNT_ROLE=TEACHER
# PostgreSQL do compose de desenvolvimento.
COMPOSE_PROJECT_NAME=evidentia-dev
POSTGRES_USER=evidentia
POSTGRES_DB=evidentia_dev
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
